{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": ["scripts/**"],
  "rules": {
    "exports": "off",
    "types": "off"
  },
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    "src/cashier_frontend_new": {
      "project": ["src/**"],
      "ignore": [
        "src/lib/generated/**",
        "src/lib/paraglide/**",
        "src/lib/shadcn/**"
      ],
      "ignoreDependencies": [
        "@eslint/compat",
        "@tailwindcss/forms",
        "@tailwindcss/typography",
        "@vitest/coverage-v8",
        "cross-fetch",
        "ic-vetkd-utils",
        "vitest-browser-svelte"
      ],
      "ignoreUnresolved": ["\\$env/.+"]
    },
    "src/gate_frontend": {
      "project": ["src/**"],
      "ignore": ["src/lib/generated/**"],
      "ignoreDependencies": [
        "@eslint/compat",
        "@vitest/coverage-v8"
      ]
    },
    "src/lib/cashier_shared": {
      "entry": ["logic/**/*.ts", "scripts/**/*.ts"],
      "project": ["**/*.ts"],
      "ignore": ["generated/**"]
    }
  }
}
