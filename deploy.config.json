{
  "deployBranches": ["main", "staging"],
  "deployTargets": [
    {
      "name": "backend",
      "workflow": "orbit-backend-deploy.yml",
      "paths": [
        "src/cashier_backend/",
        "src/token_storage/",
        "src/transaction_manager/",
        "src/shared/",
        ".github/workflows/orbit-backend-deploy.yml"
      ]
    },
    {
      "name": "frontend",
      "workflow": "orbit-frontend-deploy.yml",
      "paths": [
        "src/cashier_frontend_new/",
        "src/shared/",
        ".github/workflows/orbit-frontend-deploy.yml"
      ]
    },
    {
      "name": "wallet",
      "workflow": "orbit-wallet-deploy.yml",
      "paths": [
        "src/cashier_wallet/",
        ".github/workflows/orbit-wallet-deploy.yml"
      ]
    }
  ]
}
