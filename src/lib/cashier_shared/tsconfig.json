{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "./generated/ts",
		"rootDir": "./generated/ts",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"resolveJsonModule": true
	},
	"include": ["generated/ts/**/*.ts"],
	"exclude": ["node_modules", "generated/ts/**/*.d.ts", "generated/ts/**/*.js"]
}
