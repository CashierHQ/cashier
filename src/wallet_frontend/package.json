{
  "name": "wallet_frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001 --mode local_dev",
    "dev:dev": "vite dev --port 3001 --mode dev",
    "build:local_dev": "vite build --mode local_dev",
