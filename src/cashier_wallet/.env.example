# PUBLIC_DAPP_ORIGIN is no longer used by the wallet — the wallet accepts
# connections from any DApp origin to support multi-DApp integration.
# Security is enforced by the user consent flow, which displays the requesting
# DApp origin so the user can make an informed decision.

# Optional: comma-separated extra hostnames Vite's dev server should accept
# (e.g. a Cloudflare Tunnel or ngrok URL). Leave empty for local-only dev.
# ALLOWED_HOSTS=your-tunnel.trycloudflare.com
