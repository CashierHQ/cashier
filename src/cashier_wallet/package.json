    "jsdom": "^27.0.0",
    "svelte": "^4.2.7",
    "svelte-check": "^4.0.0",
    "vite": "^5.0.3",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@dfinity/agent": "^2.4.1",
    "@dfinity/auth-client": "^2.4.1",
    "@dfinity/candid": "^2.4.1",
