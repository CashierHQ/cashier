{
  "name": "wallet",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5177 --mode local_dev",
    "dev:dev": "vite dev --port 5177 --mode dev",
    "build:local_dev": "vite build --mode local_dev",
    "build:dev": "vite build --mode dev",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "echo 'wallet has no lint config yet — skip'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cashier-wallet/wallet-sdk": "workspace:*",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^25.4.0",
    "jsdom": "^27.4.0",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@dfinity/oisy-wallet-signer": "^4.1.3",
    "@dfinity/utils": "^4.2.1",
    "@dfinity/zod-schemas": "^3",
    "@icp-sdk/auth": "^7",
    "@icp-sdk/canisters": "^3.2",
    "@icp-sdk/core": "^5.4",
    "marked": "^15.0.0",
    "zod": "^4.4.3"
  }
}