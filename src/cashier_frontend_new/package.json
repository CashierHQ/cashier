{
  "name": "cashier_frontend_new",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000 --mode local_dev",
    "dev:dev": "vite dev --port 3000 --mode dev",
    "dev:e2e": "vite dev --port 3001 --mode e2e",
    "build:local_dev": "vite build --mode local_dev",
    "build:dev": "vite build --mode dev",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync --mode dev && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test:e2e": "playwright install chromium && playwright test",
    "test": "pnpm test:unit --run",
    "add:ui": "pnpm dlx shadcn-svelte@latest add"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@playwright/test": "^1.60.0",
